---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Wordmark from '../../components/Wordmark.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({ params: { id: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const date = essay.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={essay.data.title} description={essay.data.summary}>
  <div class="wrap page">
    <Wordmark />
    <article class="column">
      <header>
        <p class="caps">{essay.data.kind} · {date}</p>
        <h1>{essay.data.title}</h1>
      </header>
      <div class="prose body"><Content /></div>
      <p class="back"><a class="caps" href="/essays/">All essays</a></p>
    </article>
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  article {
    width: 100%;
    max-width: 700px;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 2px solid var(--frame);
  }
  header p {
    margin: 0;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(34px, 7vw, 52px);
    line-height: 1.08;
    letter-spacing: 0.04em;
    text-wrap: balance;
  }
  /* Boxed initial on the opening paragraph. */
  .body :global(> p:first-child::first-letter) {
    float: left;
    font-family: var(--display);
    font-size: 46px;
    line-height: 1;
    padding: 9px 14px 7px;
    margin: 8px 19px 6px 5px;
    background: var(--ink);
    color: var(--bg);
    border: 2px solid var(--gold);
    box-shadow: 0 0 0 5px var(--ink);
  }
  .back {
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .back a {
    font-size: 15px;
    letter-spacing: 0.2em;
  }
</style>
